# Copia este archivo a deploy/.env y ajusta los valores.
# deploy/.env NO debe versionarse.
#
# IMPORTANTE: este archivo es la fuente AUTORITATIVA para la config de la app dentro de los
# contenedores (docker-compose lo monta con `env_file`, ver docs/09 §17). Una variable exportada
# en tu shell (por ejemplo DEEPSEEK_API_KEY para otra herramienta) NO lo pisa: lo que pongas aqui
# es lo que usa el stack.

POSTGRES_USER=pf
POSTGRES_PASSWORD=pf
POSTGRES_DB=pf

# API key del proveedor de IA (DeepSeek). Vacío = modo sin IA (S = B).
DEEPSEEK_API_KEY=

# Opcionales
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Techo de tokens por respuesta (no es gasto: se factura solo lo generado). `deepseek-flash`
# razona antes de escribir el JSON y ese razonamiento sale del mismo presupuesto; con menos de
# ~8000 el JSON puede quedar vacio (`finish_reason=length`). 16000 por defecto.
# DEEPSEEK_MAX_TOKENS=16000
# Llamadas concurrentes a DeepSeek (6 por defecto; 1 = secuencial; si hay 429, bajalo).
# AI_MAX_CONCURRENCY=6

# Firma de los tokens de sesión (doc 10). Define una cadena larga y aleatoria en un despliegue real.
SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=72

# Cuentas de demo (demo/demo123, smoke/smoke123). Pon 0 para no sembrarlas.
SEED_DEMO_USERS=1

# Origenes permitidos para llamar la API desde un navegador (CORS), separados por comas.
# Ajusta esto (o quitalo) cuando el frontend quede detras de un dominio/nginx real.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL de la API tal como la alcanza el NAVEGADOR del usuario (no el nombre del servicio en la
# red de docker-compose). Se incrusta en el build del frontend (frontend/Dockerfile) -- cambiar
# esto implica reconstruir la imagen del frontend (`docker compose build frontend`).
VITE_API_BASE_URL=http://localhost:8000

# Segundos que un job puede quedarse "en_progreso" antes de que el propio worker (worker-core o
# worker-logs) lo marque fallido -- ver backend/.env.example.
JOB_STALE_TIMEOUT_SECONDS=600

# Segundos que un job `pendiente` (sin worker que lo tome) espera antes de marcarse fallido.
JOB_PENDING_TIMEOUT_SECONDS=120
