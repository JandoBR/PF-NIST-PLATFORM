# Copia este archivo a deploy/.env y ajusta los valores.
# deploy/.env NO debe versionarse.

POSTGRES_USER=pf
POSTGRES_PASSWORD=pf
POSTGRES_DB=pf

# API key del proveedor de IA (DeepSeek). Vacío = modo sin IA (S = B).
DEEPSEEK_API_KEY=

# Opcionales
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Origenes permitidos para llamar la API desde un navegador (CORS), separados por comas.
# Ajusta esto (o quitalo) cuando el frontend quede detras de un dominio/nginx real.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL de la API tal como la alcanza el NAVEGADOR del usuario (no el nombre del servicio en la
# red de docker-compose). Se incrusta en el build del frontend (frontend/Dockerfile) -- cambiar
# esto implica reconstruir la imagen del frontend (`docker compose build frontend`).
VITE_API_BASE_URL=http://localhost:8000
