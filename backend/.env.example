# Copia este archivo a backend/.env (no se versiona; ver .gitignore) y pon tu clave real.
# Sin DEEPSEEK_API_KEY, app.main sigue funcionando: la extraccion documental se omite (S = B).

DEEPSEEK_API_KEY=

# Opcionales (valores por defecto si se omiten)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
