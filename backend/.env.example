# Copia este archivo a backend/.env (no se versiona; ver .gitignore) y pon tu clave real.
# Sin DEEPSEEK_API_KEY, app.main sigue funcionando: la extraccion documental se omite (S = B).

DEEPSEEK_API_KEY=

# Opcionales (valores por defecto si se omiten)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Techo de tokens por respuesta (no es gasto: se factura solo lo generado). `deepseek-flash`
# razona antes de escribir el JSON y ese razonamiento sale del mismo presupuesto; con menos de
# ~8000 el JSON puede quedar vacio (`finish_reason=length`). 16000 por defecto.
# DEEPSEEK_MAX_TOKENS=16000
# Llamadas concurrentes a DeepSeek (6 por defecto; 1 = secuencial; si hay 429, bajalo).
# AI_MAX_CONCURRENCY=6

# Firma de los tokens de sesión (doc 10). En el prototipo hay un default inseguro; en un
# despliegue real define una cadena larga y aleatoria.
SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=72

# Cuentas de demo (demo/demo123, smoke/smoke123). Pon 0 para no sembrarlas.
SEED_DEMO_USERS=1

# Origenes permitidos para llamar la API desde un navegador (CORS), separados por comas.
# Por defecto solo el dev server de Vite. Cuando haya un dominio real detras de nginx, agregalo
# aqui (o, si el front queda same-origin con la API, esto deja de ser necesario).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Segundos que un job puede quedarse "en_progreso" antes de que el propio worker lo marque
# fallido (probable caida del proceso que lo tomo, sin heartbeat real todavia -- docs/09 §18).
JOB_STALE_TIMEOUT_SECONDS=600

# Segundos que un job `pendiente` (que ningun worker tomo, p. ej. sin worker-core corriendo)
# espera antes de marcarse fallido -- docs/09 §20.
JOB_PENDING_TIMEOUT_SECONDS=120
