# Imagen de la API. Construir desde la raiz del proyecto:
#   docker build -f backend/docker/Dockerfile.api -t pf-api ..
#
# backend/ es un proyecto `uv` sin [build-system] (app plana, no un paquete instalable con
# pip) -- por eso esto usa `uv sync`, no `pip install -e`.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir uv

WORKDIR /app/backend

# Capa de dependencias separada del codigo: cambiar codigo sin tocar pyproject.toml/uv.lock
# no reinstala nada.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/ .

ENV PATH="/app/backend/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uvicorn", "app.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
