# Imagen de los workers (objetivo). El comando se define en el compose:
#   worker-core -> python -m app.workers.core
#   worker-logs -> python -m app.workers.logs
# Construir desde la raíz del proyecto:
#   docker build -f backend/docker/Dockerfile.worker -t pf-worker .

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/ backend/

RUN pip install --no-cache-dir -e backend

WORKDIR /app/backend

CMD ["python", "-m", "app.workers.core"]
